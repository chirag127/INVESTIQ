---
title: "Financial Calculators — InvestiQ India"
description: "Tested, client-side Indian financial calculators with zero server transmission."
import SIPCalculator from '../../components/calculators/SIPCalculator';
import TaxRegimeCalculator from '../../components/calculators/TaxRegimeCalculator';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Financial Calculators — InvestiQ India</title>
    <style>
      :root {
        --bg-color: #0d1117;
        --card-bg: #161b22;
        --text-primary: #e6edf3;
        --text-muted: #8b949e;
        --accent: #2ea043;
        --border-color: #30363d;
      }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background-color: var(--bg-color);
        color: var(--text-primary);
        line-height: 1.6;
      }
      header {
        border-bottom: 1px solid var(--border-color);
        padding: 1.25rem 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .logo a {
        font-weight: 700;
        font-size: 1.3rem;
        color: #ffffff;
        text-decoration: none;
      }
      .logo span {
        color: var(--accent);
      }
      .container {
        max-width: 900px;
        margin: 0 auto;
        padding: 2.5rem 1.5rem;
      }
      h1 {
        font-size: 2.2rem;
        margin-bottom: 0.5rem;
      }
      .subtitle {
        color: var(--text-muted);
        margin-bottom: 2rem;
      }
      .calc-section {
        margin-bottom: 3rem;
      }
      nav a {
        color: var(--text-muted);
        text-decoration: none;
        margin-left: 1rem;
        font-size: 0.9rem;
      }
      nav a:hover {
        color: var(--text-primary);
      }
    </style>
  </head>
  <body>
    <header>
      <div class="logo"><a href="/INVESTIQ/">InvestiQ <span>India</span></a></div>
      <nav>
        <a href="/INVESTIQ/">Home</a>
        <a href="/INVESTIQ/book/">Book Corpus</a>
        <a href="/INVESTIQ/calculators/">Calculators</a>
      </nav>
    </header>

    <main class="container">
      <h1>Financial Calculators</h1>
      <p class="subtitle">Client-side personal finance engines. All calculations execute locally on your device with zero data uploaded to servers.</p>

      <section class="calc-section">
        <SIPCalculator client:load />
      </section>

      <section class="calc-section">
        <TaxRegimeCalculator client:load />
      </section>
    </main>
  </body>
</html>
